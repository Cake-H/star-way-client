# 生产环境：使用相对路径 /app，由 Nginx 反向代理到后端
VITE_API_BASE_URL=/app

# 浏览器扩展商店链接（正式上架后填入真实地址）
# VITE_EXTENSION_CHROME_URL=
# VITE_EXTENSION_EDGE_URL=
# VITE_EXTENSION_FIREFOX_URL=

# 浏览器扩展测试包（公测期免商店分发；由 Nginx 静态目录提供下载）
VITE_EXTENSION_ZIP_URL=/app/downloads/dist.zip
VITE_EXTENSION_BETA_VERSION=v0.1.0-beta
