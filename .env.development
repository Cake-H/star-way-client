# 本地开发：直连本机后端 ida-app-server（正式客户端，非 plugin 端）
VITE_API_BASE_URL=http://localhost:8088/api/v1/app
# VITE_API_BASE_URL=http://8.166.120.136:8088/api/v1/app

# 设为 false 时使用 localStorage mock，不请求 /interview/*
VITE_INTERVIEW_USE_API=true

# 设为 false 时模拟面试走 localStorage mock，便于后端未就绪时独立开发
VITE_MOCK_INTERVIEW_USE_API=true

# 浏览器扩展测试包下载地址（本地联调时可指向本机静态服务）
# VITE_EXTENSION_ZIP_URL=http://localhost:8088/downloads/xingtu-extension-beta.zip
# VITE_EXTENSION_BETA_VERSION=v0.1.0-beta
